<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="4dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/circle_placeholder"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvPublicProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Traveler Name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvPublicProfileStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scanning itineraries..."
        android:textSize="16sp"
        android:textColor="#757575"
        android:layout_marginTop="12dp"
        android:textAlignment="center"/>

    <Button
        android:id="@+id/btnPublicProfileChat"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Checking Connection..."
        android:backgroundTint="#9E9E9E"
        android:textColor="#FFFFFF"
        android:enabled="false"
        android:layout_marginTop="40dp"/>

    <Button
        android:id="@+id/btnPublicProfileBack"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Go Back"
        android:backgroundTint="#E0E0E0"
        android:textColor="#000000"
        android:layout_marginTop="12dp"/>
</LinearLayout>