<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPaymentPropName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Booking: Name\nTotal: $0.0" />

    <EditText
        android:id="@+id/etPromoCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Promo Code (Optional)"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnApplyPromo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply Promo" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Payment Method"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <RadioGroup
        android:id="@+id/rgPaymentMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@+id/rbCreditCard">
        <RadioButton android:id="@+id/rbCreditCard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Credit/Debit Card" />
        <RadioButton android:id="@+id/rbPayPal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PayPal" />
        <RadioButton android:id="@+id/rbProperty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pay at Property" />
    </RadioGroup>

    <Button
        android:id="@+id/btnConfirmPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#4CAF50"
        android:text="Confirm Payment"
        android:layout_marginTop="24dp"/>
</LinearLayout>